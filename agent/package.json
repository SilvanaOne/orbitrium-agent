{
  "name": "orbitrium",
  "version": "0.1.1",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsc",
    "agent": "NODE_NO_WARNINGS=1 node --enable-source-maps dist/src/agent.js",
    "docker": "docker compose up build --build --remove-orphans",
    "test": "NODE_NO_WARNINGS=1 node --loader=ts-node/esm --enable-source-maps -r dotenv/config --require dotenv/config  --env-file=.env --env-file=.env.app --test",
    "state": "npm run test test/state.test.ts",
    "click": "npm run test test/click.test.ts",
    "batch": "npm run test test/batch.test.ts",
    "app": "npm run test test/app.test.ts",
    "deploy": "MINA_CHAIN=zeko:testnet npm run test test/deploy.test.ts",
    "compile": "npm run test test/compile.test.ts",
    "update": "ncu -i",
    "update-agent": "npm run test test/update.test.ts"
  },
  "node": {
    "version": ">=22.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "dotenv": "^17.2.2",
    "prisma": "^6.19.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@mysten/sui": "^1.38.0",
    "@prisma/client": "^6.19.0",
    "@silvana-one/agent": "^1.1.11",
    "@silvana-one/coordination": "^1.1.11",
    "@silvana-one/mina-utils": "^1.1.11",
    "@silvana-one/storage": "^1.1.11",
    "o1js": "2.10.0",
    "tslib": "^2.8.1"
  }
}

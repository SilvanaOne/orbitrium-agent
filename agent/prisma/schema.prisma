// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model GameContractData {
  id                      Int      @id @default(autoincrement())
  userMinaAddress           String
  userSuiAddress            String
  suiContractAddress        String
  minaContractAddress       String
  minaContractPrivateKey    String
  adminAddress              String
  txHash                    String
  createdAt                 DateTime @default(now())

  @@index([userMinaAddress])
  @@index([userSuiAddress])
}